{
  "name": "tips-desktop",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@10.34.5",
  "engines": {
    "node": ">=22"
  },
  "type": "module",
  "scripts": {
    "dev": "vite",
    "security:check": "node scripts/security-check.mjs",
    "build": "pnpm security:check && vue-tsc --noEmit && vite build",
    "build:desktop": "tauri build --no-bundle",
    "build:release": "tauri build",
    "release:check": "node scripts/release-check.mjs",
    "preview": "vite preview",
    "tauri": "tauri"
  },
  "dependencies": {
    "@tauri-apps/api": "^2",
    "vue": "^3.5.13",
    "vue-i18n": "^11.4.8"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2",
    "@vitejs/plugin-vue": "^5.2.1",
    "typescript": "~5.6.2",
    "vite": "^6.0.3",
    "vue-tsc": "^2.1.10"
  }
}
